<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Hears Taken / Snooze from the Sabr watch tile. Only paired watches with the same
         app (same package and signing key) can reach it. -->
    <service
      android:name="expo.modules.sabrwear.SabrWearListenerService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data android:scheme="wear" android:host="*" android:pathPrefix="/sabr" />
      </intent-filter>
    </service>
  </application>
</manifest>
